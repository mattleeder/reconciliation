@page "/import"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Reconciliation.Data.Processing
@using Reconciliation.Domain.Entities
@using Reconciliation.Domain.Import
@using Reconciliation.Web.Services
@inject RunSubmitter runSubmitter
@inject SampleRunService sampleRunService
@inject NavigationManager Nav
<PageTitle>Import</PageTitle>

<div class="page-header">
    <h1>Import</h1>
    <p>Choose a bank CSV and a ledger CSV (max 1 MB each), check them, then reconcile.</p>
</div>

<div class="card">
    <h2>Try it with sample data</h2>
    <p>Creates a run from the example bank and ledger files, so you can see the results without uploading anything.</p>
    <div class="actions">
        <button disabled="@isSaving" @onclick="OnSampleClicked">Try with sample data</button>
    </div>
</div>

<h2>Or import your own files</h2>
<div class="card">
    <label class="field">
        <span class="field-label">Bank CSV</span>
        <InputFile OnChange="OnBankSelected" accept=".csv" />
    </label>
    <label class="field">
        <span class="field-label">Ledger CSV</span>
        <InputFile OnChange="OnLedgerSelected" accept=".csv" />
    </label>
    <div class="actions">
        <button class="secondary" disabled="@(bankFile is null || ledgerFile is null)" @onclick="OnImportClicked">Check files</button>
        <button disabled="@(isSaving || bankResult is null || ledgerResult is null || bankResult.Errors.Count > 0 || ledgerResult.Errors.Count > 0)" @onclick="OnReconcileClicked">Reconcile</button>
    </div>
</div>

@if (readError is not null)
{
    <div class="alert error">@readError</div>
}
@if (isSaving)
{
    <div class="alert">Saving...</div>
}
@if (summary is not null)
{
    <div class="alert success">@summary <a href="runs">View runs</a></div>
}

@if (bankResult is not null)
{
    <h3>Bank</h3>
    <div class="alert @(bankResult.Errors.Count > 0 ? "error" : "success")">Read @bankResult.Transactions.Count rows@(bankResult.Errors.Count > 0 ? $", {bankResult.Errors.Count} with errors" : "")</div>
    if (bankResult.Errors.Count > 0)
    {
        <div class="card flush">
            <table>
                <tr>
                    <th>Line Number</th>
                    <th>Error Message</th>
                </tr>
                @foreach (var error in bankResult.Errors)
                {
                    <tr>
                        <td>@error.LineNumber</td>
                        <td>@error.Message</td>
                    </tr>
                }
            </table>
        </div>
    }
}
@if (ledgerResult is not null)
{
    <h3>Ledger</h3>
    <div class="alert @(ledgerResult.Errors.Count > 0 ? "error" : "success")">Read @ledgerResult.Transactions.Count rows@(ledgerResult.Errors.Count > 0 ? $", {ledgerResult.Errors.Count} with errors" : "")</div>
    if (ledgerResult.Errors.Count > 0)
    {
        <div class="card flush">
            <table>
                <tr>
                    <th>Line Number</th>
                    <th>Error Message</th>
                </tr>
                @foreach (var error in ledgerResult.Errors)
                {
                    <tr>
                        <td>@error.LineNumber</td>
                        <td>@error.Message</td>
                    </tr>
                }
            </table>
        </div>
    }
}
@code
{
    IBrowserFile? bankFile;
    IBrowserFile? ledgerFile;
    CsvParseResult? bankResult;
    CsvParseResult? ledgerResult;
    string? readError;
    string? summary;
    bool isSaving;
    string? bankText;
    string? ledgerText;
    private const long MaxFileSizeBytes = 1024 * 1024;
    private void OnBankSelected(InputFileChangeEventArgs e)
    {
        bankFile = e.File;
        readError = null;
        bankResult = null;
        ledgerResult = null;
        summary = null;
        bankText = null;
        ledgerText = null;
    }
    private void OnLedgerSelected(InputFileChangeEventArgs e)
    {
        ledgerFile = e.File;
        readError = null;
        bankResult = null;
        ledgerResult = null;
        summary = null;
        bankText = null;
        ledgerText = null;
    }
    private static async Task<string> ReadTextAsync(IBrowserFile file)
    {
        using var stream = file.OpenReadStream(MaxFileSizeBytes);
        using var reader = new StreamReader(stream);
        return await reader.ReadToEndAsync();
    }
    private async Task OnImportClicked()
    {
        readError = null;
        bankResult = null;
        ledgerResult = null;
        summary = null;
        bankText = null;
        ledgerText = null;
        if (bankFile == null || ledgerFile == null)
        {
            return;
        }
        try
        {
            bankText   = await ReadTextAsync(bankFile);
            ledgerText = await ReadTextAsync(ledgerFile);
            ledgerResult = TransactionCsvParser.Parse(ledgerText, TransactionSource.Ledger);
            bankResult   = TransactionCsvParser.Parse(bankText, TransactionSource.Bank);
        }
        catch (IOException)
        {
            bankText = null;
            ledgerText = null;
            readError = "A file is larger than 1 MB.";
        }
    }
    private async Task OnSampleClicked()
    {
        isSaving = true;
        readError = null;
        summary = null;

        try
        {
            var bankCsv = await SampleFiles.ReadAsync("bank.csv");
            var ledgerCsv = await SampleFiles.ReadAsync("ledger.csv");
            var result = await sampleRunService.SubmitAsync(bankCsv, ledgerCsv);

            Nav.NavigateTo($"runs/{result.RunId}");
        }
        catch (DbUpdateException)
        {
            readError = "Could not save the sample run to the database.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task OnReconcileClicked()
    {
        if (bankFile == null || ledgerFile == null || bankResult == null || ledgerResult == null || bankText == null || ledgerText == null)
        {
            return;
        }
        isSaving = true;
        summary = null;
        readError = null;
        try
        {
            var submitResult = await runSubmitter.SubmitAsync(bankFile.Name, bankText, ledgerFile.Name, ledgerText);

            if (submitResult.Queued)
            {
                summary = $"Run #{submitResult.RunId} saved and queued for processing.";
            }
            else
            {
                summary = $"Run #{submitResult.RunId} was saved but could not be queued. See its details.";
            }

            bankResult = null;
            ledgerResult = null;
            bankText = null;
            ledgerText = null;

        }
        catch (DbUpdateException)
        {
            readError = "Could not save the run to the database.";
        }
        finally
        {
            isSaving = false;
        }
    }
}