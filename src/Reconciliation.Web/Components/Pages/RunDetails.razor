@page "/runs/{Id:int}"
@using Microsoft.EntityFrameworkCore
@using Reconciliation.Data
@using Reconciliation.Domain.Entities
@using Reconciliation.Domain.Matching
@rendermode InteractiveServer
@implements IDisposable
@inject IDbContextFactory<ReconciliationDbContext> DbFactory

<PageTitle>Run Details</PageTitle>

@if (!loaded)
{
    <p class="empty">Loading...</p>
}
else if (run is null)
{
    <div class="card empty">Run not found. <a href="runs">Back to runs</a></div>
}
else
{
    <div class="page-header">
        <h1>Run #@run.Id <span class="badge badge-@run.Status.ToString().ToLowerInvariant()">@run.Status</span></h1>
        <p><a href="runs">&larr; Back to runs</a></p>
    </div>

    <div class="meta">
        <span>Created <strong>@run.CreatedUtc.ToString("yyyy-MM-dd HH:mm") UTC</strong></span>
        <span>Bank file <strong>@run.BankFileName</strong></span>
        <span>Ledger file <strong>@run.LedgerFileName</strong></span>
    </div>

    @if (run.Status == RunStatus.Pending)
    {
        <div class="alert">This run is waiting to be processed.</div>
        <button @onclick="LoadAsync">Refresh</button>
    }
    else if (run.Status == RunStatus.Failed)
    {
        <div class="alert error">This run failed: @run.FailureReason</div>
    }
    else if (matches is not null)
    {
        <div class="stat-grid">
            <div class="stat">
                <span class="value">@matches.Count(m => m.Kind == MatchKind.ExactAmountAndDate)</span>
                <span class="label">Exact matches</span>
            </div>
            <div class="stat">
                <span class="value">@matches.Count(m => m.Kind == MatchKind.FuzzyDescription)</span>
                <span class="label">Fuzzy matches</span>
            </div>
            <div class="stat">
                <span class="value">@matches.Count(m => m.Kind == MatchKind.PossibleDuplicate)</span>
                <span class="label">Possible duplicates</span>
            </div>
        </div>

        <h2>Matches</h2>
        <label class="field">
            <span class="field-label">Filter</span>
            <select @bind="kindFilter">
                <option value="">All</option>
                <option value="@MatchKind.ExactAmountAndDate">Exact Match</option>
                <option value="@MatchKind.FuzzyDescription">Fuzzy Match</option>
                <option value="@MatchKind.PossibleDuplicate">Possible Duplicate</option>
            </select>
        </label>

        @if (error is not null)
        {
            <div class="alert error">@error</div>
        }

        <div class="card flush">
            <table>
                <tr>
                    <th>Kind</th>
                    <th>Left</th>
                    <th>Right</th>
                    <th class="num">Amount</th>
                    <th class="num">Confidence</th>
                    <th>Review</th>
                </tr>
                @foreach (var m in matches.Where(x => kindFilter == null || x.Kind == kindFilter))
                {
                    <tr>
                        <td><span class="badge badge-@m.Kind.ToString().ToLowerInvariant()">@m.Kind</span></td>
                        <td>@m.LeftTransaction?.Date.ToString("yyyy-MM-dd") @m.LeftTransaction?.Description</td>
                        <td>@m.RightTransaction?.Date.ToString("yyyy-MM-dd") @m.RightTransaction?.Description</td>
                        <td class="num">@(m.LeftTransaction is null ? "" : Money.Format(m.LeftTransaction.Amount))</td>
                        <td class="num">@m.Confidence.ToString("0.00")</td>
                        <td>
                            <div class="review">
                                @if (m.Decision is null)
                                {
                                    <button class="small approve" @onclick="() => ReviewAsync(m, ReviewOutcome.Approved)">Approve</button>
                                    <button class="small reject" @onclick="() => ReviewAsync(m, ReviewOutcome.Rejected)">Reject</button>
                                }
                                else
                                {
                                    <span class="badge badge-@m.Decision.Outcome.ToString().ToLowerInvariant()">@m.Decision.Outcome</span>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </table>
        </div>

        <h3>Unmatched bank rows</h3>
        @if (unmatchedBank is null || unmatchedBank.Count == 0)
        {
            <div class="card empty">None</div>
        }
        else
        {
            <div class="card flush">
                <table>
                    <tr>
                        <th>Date</th>
                        <th class="num">Amount</th>
                        <th>Description</th>
                    </tr>
                    @foreach (var t in unmatchedBank)
                    {
                        <tr>
                            <td>@t.Date.ToString("yyyy-MM-dd")</td>
                            <td class="num">@Money.Format(t.Amount)</td>
                            <td>@t.Description</td>
                        </tr>
                    }
                </table>
            </div>
        }

        <h3>Unmatched ledger rows</h3>
        @if (unmatchedLedger is null || unmatchedLedger.Count == 0)
        {
            <div class="card empty">None</div>
        }
        else
        {
            <div class="card flush">
                <table>
                    <tr>
                        <th>Date</th>
                        <th class="num">Amount</th>
                        <th>Description</th>
                    </tr>
                    @foreach (var t in unmatchedLedger)
                    {
                        <tr>
                            <td>@t.Date.ToString("yyyy-MM-dd")</td>
                            <td class="num">@Money.Format(t.Amount)</td>
                            <td>@t.Description</td>
                        </tr>
                    }
                </table>
            </div>
        }
    }
}
@code
{
    [Parameter] public int Id { get; set; }
    private ReconciliationRun? run;
    private List<Match>? matches;
    private bool loaded;
    private MatchKind? kindFilter;
    private string? error;
    private List<Transaction>? unmatchedBank;
    private List<Transaction>? unmatchedLedger;
    private readonly CancellationTokenSource pollCts = new();

    private async Task ReviewAsync(Match match, ReviewOutcome outcome)
    {
        error = null;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var decision = new ReviewDecision
            {
                MatchId = match.Id,
                Outcome = outcome,
                DecidedAtUtc = DateTime.UtcNow,
            };

            db.ReviewDecisions.Add(decision);
            await db.SaveChangesAsync();
            match.Decision = decision;
        }
        catch (DbUpdateException)
        {
            error = "Could not save the decision. It may already have been reviewed.";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _ = PollWhilePendingAsync();
        }
    }

    // A new run is Pending until the worker picks it up (a cold Function App can take a while),
    // so reload every few seconds until it is no longer Pending. The Refresh button still works.
    private async Task PollWhilePendingAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));

        try
        {
            while (run?.Status == RunStatus.Pending && await timer.WaitForNextTickAsync(pollCts.Token))
            {
                await LoadAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception)
        {
            // A failed reload (for example the database waking up) just stops the polling.
        }
    }

    public void Dispose()
    {
        pollCts.Cancel();
        pollCts.Dispose();
    }

    private async Task LoadAsync()
    {
        matches = null;
        unmatchedBank = null;
        unmatchedLedger = null;

        await using var db = await DbFactory.CreateDbContextAsync();
        run = await db.Runs.AsNoTracking().FirstOrDefaultAsync(r => r.Id == Id);

        if (run != null && run.Status == RunStatus.Complete)
        {
            matches = await db.Matches.AsNoTracking()
            .Include(m => m.LeftTransaction)
            .Include(m => m.RightTransaction)
            .Include(m => m.Decision)
            .Where(m => m.LeftTransaction!.RunId == Id)
            .OrderBy(m => m.Id)
            .ToListAsync();

            var transactions = await db.Transactions.AsNoTracking()
                .Where(t => t.RunId == Id)
                .OrderBy(t => t.Date)
                .ThenBy(t => t.Id)
                .ToListAsync();

            var matchedIds = matches
                .Where(m => m.Kind != MatchKind.PossibleDuplicate)
                .SelectMany(m => new[] { m.LeftTransactionId, m.RightTransactionId })
                .ToHashSet();

            unmatchedBank = transactions
                .Where(t => t.Source == TransactionSource.Bank && !matchedIds.Contains(t.Id))
                .ToList();
            unmatchedLedger = transactions
                .Where(t => t.Source == TransactionSource.Ledger && !matchedIds.Contains(t.Id))
                .ToList();
        }
        loaded = true;
    }
}