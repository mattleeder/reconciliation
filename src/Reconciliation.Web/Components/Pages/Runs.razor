@page "/runs"
@using Microsoft.EntityFrameworkCore
@using Reconciliation.Data
@using Reconciliation.Domain.Entities
@rendermode InteractiveServer
@inject IDbContextFactory<ReconciliationDbContext> DbFactory
@inject NavigationManager Nav

<PageTitle>Runs</PageTitle>

<div class="page-header">
    <h1>Runs</h1>
    <p>Every reconciliation run, newest first.</p>
</div>

@if (runs is null)
{
    <p class="empty">Loading...</p>
}
else if (runs.Count == 0)
{
    <div class="card empty">No runs yet. <a href="import">Import your first files</a>.</div>
}
else
{
    <div class="card flush">
    <table>
        <tr>
            <th>Run</th>
            <th>Status</th>
            <th>Created (UTC)</th>
            <th>Completed (UTC)</th>
            <th>Bank File</th>
            <th>Ledger File</th>
        </tr>
        @foreach(var run in runs)
        {
            <tr class="clickable" @onclick="() => OpenRun(run.Id)">
                <td><a href="runs/@run.Id">#@run.Id</a></td>
                <td><span class="badge badge-@run.Status.ToString().ToLowerInvariant()">@run.Status</span></td>
                <td>@run.CreatedUtc.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@(run.CompletedUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                <td>@run.BankFileName</td>
                <td>@run.LedgerFileName</td>
            </tr>
        }
    </table>
    </div>
}

@code
{
    private List<ReconciliationRun>? runs;

    private void OpenRun(int id) => Nav.NavigateTo($"runs/{id}");

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        runs = await db.Runs.AsNoTracking().OrderByDescending(r => r.CreatedUtc).ToListAsync();
    }
}